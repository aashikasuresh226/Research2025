        right.pack(side=tk.RIGHT, fill=tk.BOTH, expand=False, pady=0)
        right.configure(width=490)
        right.pack_propagate(False)

        tk.Label(right, text="PEAK ANALYSIS TABLE", bg=PANEL, fg=SUBTEXT,
