# ──────────────────────────────────────────────────────────────────────────────
def vertical_diameter_px(contour):
    """
    Return the diameter of a particle measured along the Y axis (vertical span).

    For oddly-shaped blobs this is more physically meaningful than the major
    axis of an ellipse fit, because microfluidic deformation is typically
    observed as elongation along the flow direction (horizontal).  The vertical
    extent therefore gives the true cross-sectional diameter independent of
    shape eccentricity.

    Falls back to minAreaRect minor axis if the contour has fewer than 2 points.
    """
    if contour is None or len(contour) < 2:
        # Fallback
        (_, _), (w, h), _ = cv2.minAreaRect(contour) if contour is not None and len(contour) >= 4 else ((0,0),(1,1),0)
        return float(min(w, h))
    pts = contour.reshape(-1, 2)
    return float(pts[:, 1].max() - pts[:, 1].min())


# ──────────────────────────────────────────────────────────────────────────────
class Particle:
    def __init__(self, pid, centroid, area, bbox, taylor,
                 major_px, minor_px, vdiam_px, frame_num):
        self.id        = pid
        self.centroid  = centroid
        self.area      = area
        self.bbox      = bbox
        self.last_seen = frame_num
        self.alive     = True
        self.color     = self._gen_color()

        self.trajectory    = [centroid]
        self.frame_history = [frame_num]

        self.major_history  = [major_px]   # ellipse major axis (px)
        self.minor_history  = [minor_px]   # ellipse minor axis (px)
        self.vdiam_history  = [vdiam_px]   # vertical diameter (px)  ← primary

        self.taylor_history   = [taylor]
        self.velocity_history = []          # px / frame (crop pixels)

        # ── peak / derivative tracking ────────────────────────────────────────
        self.taylor_derivative_history = [np.nan]

        self.peak_confirmed       = False
        self.peak_confirmed_frame = None

        self._candidate_peak_value = taylor
        self._candidate_peak_idx   = 0
        self._frames_declining      = 0

        self.max_taylor             = taylor
        self.max_taylor_frame       = frame_num
        self.velocity_at_max_taylor = None   # set after peak frame is finalised
        self.viscoelastic_tau       = None

        # ── delta-Taylor & velocity around peak (filled once peak confirmed) ──
        self.taylor_before_peak  = None   # Taylor value 1 frame before peak
        self.taylor_after_peak   = None   # Taylor value 1 frame after peak
        self.delta_taylor        = None   # after − before  (signed)
        self.velocity_before_peak = None  # µm/s one frame before peak frame
        self.velocity_after_peak  = None  # µm/s one frame after peak frame

    def _gen_color(self):
        hue = (self.id * 137.5) % 360
        sat = 0.7 + (self.id % 3) * 0.1
        val = 0.8 + (self.id % 2) * 0.2
        return hsv_to_rgb([hue / 360, sat, val])

    def _update_peak_detection(self, taylor, frame_num):
        if self.peak_confirmed:
            return
        if taylor > self._candidate_peak_value:
            self._candidate_peak_value = taylor
            self._candidate_peak_idx   = len(self.taylor_history)
            self._frames_declining     = 0
        elif taylor < self._candidate_peak_value:
            self._frames_declining += 1
            if self._frames_declining >= PEAK_CONFIRM_FRAMES:
                self.peak_confirmed       = True
                self.peak_confirmed_frame = frame_num
                self._finalise_peak_stats()

    def _finalise_peak_stats(self):
        """Compute Δtaylor and velocities around the confirmed peak."""
        try:
            peak_list_idx = self.taylor_history.index(self.max_taylor)
        except ValueError:
            return

        # Taylor values immediately before / after peak
        if peak_list_idx > 0:
            self.taylor_before_peak = self.taylor_history[peak_list_idx - 1]
        if peak_list_idx + 1 < len(self.taylor_history):
            self.taylor_after_peak = self.taylor_history[peak_list_idx + 1]

        if (self.taylor_before_peak is not None and
                self.taylor_after_peak is not None):
            self.delta_taylor = self.taylor_after_peak - self.taylor_before_peak

        # velocity_history has one fewer entry than frame_history
        # velocity_history[i] = speed between frame_history[i] and frame_history[i+1]
        # So velocity BEFORE peak frame = velocity_history[peak_list_idx - 1]
        # velocity AFTER peak frame    = velocity_history[peak_list_idx]
        if peak_list_idx > 0 and (peak_list_idx - 1) < len(self.velocity_history):
            self.velocity_before_peak = self.velocity_history[peak_list_idx - 1]
        if peak_list_idx < len(self.velocity_history):
            self.velocity_after_peak = self.velocity_history[peak_list_idx]

    def _compute_derivative(self):
        if not self.peak_confirmed:
            return np.nan
        try:
            peak_confirmed_list_idx = self.frame_history.index(
                self.peak_confirmed_frame)
        except ValueError:
            return np.nan
        post = self.taylor_history[peak_confirmed_list_idx:]
        if len(post) < DERIV_WINDOW:
            return np.nan
        window_slice = post[-(DERIV_WINDOW):]
        return float((window_slice[-1] - window_slice[0]) / (DERIV_WINDOW - 1))

    def update(self, centroid, area, bbox, taylor,
               major_px, minor_px, vdiam_px, frame_num):
        if self.trajectory:
            dx = centroid[0] - self.trajectory[-1][0]
            dy = centroid[1] - self.trajectory[-1][1]
            self.velocity_history.append(float(np.sqrt(dx*dx + dy*dy)))

        self._update_peak_detection(taylor, frame_num)

        self.centroid  = centroid
        self.area      = area
        self.bbox      = bbox
        self.last_seen = frame_num
        self.trajectory.append(centroid)
        self.frame_history.append(frame_num)
        self.major_history.append(major_px)
        self.minor_history.append(minor_px)
        self.vdiam_history.append(vdiam_px)
        self.taylor_history.append(taylor)
        self.taylor_derivative_history.append(self._compute_derivative())

        if taylor > self.max_taylor:
            self.max_taylor       = taylor
            self.max_taylor_frame = frame_num

        if len(self.trajectory) > 50:
            self.trajectory.pop(0)

    # ── summary helpers ───────────────────────────────────────────────────────
    def post_peak_derivatives(self):
        return [v for v in self.taylor_derivative_history if not np.isnan(v)]

    def initial_post_peak_dD_dt(self):
        vals = self.post_peak_derivatives()
        return vals[0] if vals else None

    def mean_post_peak_dD_dt(self):
        vals = self.post_peak_derivatives()
        return float(np.mean(vals)) if vals else None

    def compute_viscoelastic_tau(self):
        try:
            idx = self.taylor_history.index(self.max_taylor)
        except ValueError:
            return None
        relax = np.array(self.taylor_history[idx:])
        if len(relax) < 4 or relax[0] <= 0:
            return None
        t     = np.arange(len(relax), dtype=float)
        log_r = np.log(np.clip(relax / relax[0], 1e-9, None))
        if np.all(log_r == 0):
            return None
        slope, _ = np.polyfit(t, log_r, 1)
        return (-1.0 / slope) if slope < 0 else None


# ──────────────────────────────────────────────────────────────────────────────
class ParticleEngine:
    def __init__(self):
        self.reset()

    def reset(self):
        self.tracked_particles      = []
        self.next_particle_id       = 1
        self.total_unique_particles = 0
        self.max_distance_threshold = 50
        self.max_frames_disappeared = 10
        self.MIN_AREA               = 10

    @staticmethod
    def fit_ellipse_and_vdiam(contour):
        """
        Returns (taylor, major_px, minor_px, vdiam_px).

        taylor    : (L−B)/(L+B) from ellipse axes — dimensionless, unchanged
        major_px  : ellipse major axis in contour pixels
        minor_px  : ellipse minor axis in contour pixels
        vdiam_px  : vertical span of the contour (Y-axis diameter)
        """
        vdiam = vertical_diameter_px(contour)

        if len(contour) >= 5:
            try:
                (_, _), (ma, mi), _ = cv2.fitEllipse(contour)
                major = float(max(ma, mi))
                minor = float(min(ma, mi))
                L = major / 2.0
                B = minor / 2.0
                denom = L + B
                taylor = float((L - B) / denom) if denom > 0 else 0.0
                return taylor, major, minor, vdiam
            except cv2.error:
                pass

        (_, _), (w, h), _ = cv2.minAreaRect(contour)
        major = float(max(w, h))
        minor = float(min(w, h))
        L = major / 2.0
        B = minor / 2.0
        denom = L + B
        taylor = float((L - B) / denom) if denom > 0 else 0.0
        return taylor, major, minor, vdiam

    @staticmethod
    def centroid(contour):
        M = cv2.moments(contour)
        if M["m00"] != 0:
            return (int(M["m10"]/M["m00"]), int(M["m01"]/M["m00"]))
        x, y, w, h = cv2.boundingRect(contour)
        return (x + w//2, y + h//2)

    def _match(self, detections, frame_num):
        for p in self.tracked_particles:
            if p.alive and frame_num - p.last_seen > self.max_frames_disappeared:
                p.alive = False
        if not detections:
            return
        det_cents   = [d['centroid'] for d in detections]
        alive       = [p for p in self.tracked_particles if p.alive]
        alive_cents = [p.centroid for p in alive]
        used_p, used_d, matched = set(), set(), []
        if alive_cents:
            dm = cdist(alive_cents, det_cents)
            while True:
                tmp = dm.copy()
                for pi in used_p: tmp[pi, :] = np.inf
                for di in used_d: tmp[:, di] = np.inf
                pi, di = np.unravel_index(np.argmin(tmp), tmp.shape)
                if tmp[pi, di] >= self.max_distance_threshold:
                    break
                matched.append((pi, di)); used_p.add(pi); used_d.add(di)
        for pi, di in matched:
            d = detections[di]
            alive[pi].update(d['centroid'], d['area'], d['bbox'],
                             d['taylor'], d['major_px'], d['minor_px'],
                             d['vdiam_px'], frame_num)
        for di, d in enumerate(detections):
            if di not in used_d:
                p = Particle(self.next_particle_id,
                             d['centroid'], d['area'], d['bbox'],
                             d['taylor'], d['major_px'], d['minor_px'],
                             d['vdiam_px'], frame_num)
                self.tracked_particles.append(p)
                self.next_particle_id       += 1
                self.total_unique_particles += 1

    def process_frame(self, image, frame_num, zoom_factor=1.0,
                      min_area=10, um_per_px=1.0):
        self.MIN_AREA = min_area

        x1, y1, x2, y2 = 262, 239, 370, 365
        cropped = image[y1:y2, x1:x2]

        og_h, og_w = image.shape
        scale_w    = (x2 - x1) / og_w
        scale_h    = (y2 - y1) / og_h
        area_scale = (scale_h * scale_w) / (zoom_factor ** 2)

        blurred = cv2.GaussianBlur(cropped, (7, 7), 0)
        _, thresh = cv2.threshold(blurred, 0, 255,
                                  cv2.THRESH_BINARY + cv2.THRESH_OTSU)
        if np.sum(thresh == 255) > np.sum(thresh == 0):
            thresh = cv2.bitwise_not(thresh)

        kernel  = np.ones((2, 2), np.uint8)
        opening = cv2.morphologyEx(thresh, cv2.MORPH_OPEN, kernel, iterations=1)
        sure_bg = cv2.dilate(opening, kernel, iterations=2)
        dt      = cv2.distanceTransform(opening, cv2.DIST_L2, 5)
        _, sure_fg = cv2.threshold(dt, 0.2 * dt.max(), 255, 0)
        sure_fg = np.uint8(sure_fg)
        unknown = cv2.subtract(sure_bg, sure_fg)
        _, markers = cv2.connectedComponents(sure_fg)
        markers += 1
        markers[unknown == 255] = 0
        color_img = cv2.cvtColor(cropped, cv2.COLOR_GRAY2BGR)
        markers   = cv2.watershed(color_img, markers)
        output    = color_img.copy()
        output[markers == -1] = [0, 0, 255]

        px_to_um = um_per_px / zoom_factor

        detections = []
        for mv in np.unique(markers):
            if mv <= 1:
                continue
            mask = np.uint8(markers == mv)
            cnts, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL,
                                       cv2.CHAIN_APPROX_SIMPLE)
            for cnt in cnts:
                raw_area  = cv2.contourArea(cnt)
                norm_area = raw_area * area_scale
                if norm_area < self.MIN_AREA or cv2.arcLength(cnt, True) <= 0:
                    continue
                taylor, major_px, minor_px, vdiam_px = \
                    self.fit_ellipse_and_vdiam(cnt)
                detections.append({
                    'contour' : cnt,
                    'area'    : norm_area,
                    'centroid': self.centroid(cnt),
                    'bbox'    : cv2.boundingRect(cnt),
                    'taylor'  : taylor,
                    'major_px': major_px,
                    'minor_px': minor_px,
                    'vdiam_px': vdiam_px,
                })

        self._match(detections, frame_num)

        active = 0
        for p in self.tracked_particles:
            if not p.alive or frame_num - p.last_seen > 1:
                continue
            active += 1
            for det in detections:
                if det['centroid'] == p.centroid:
                    cv2.drawContours(output, [det['contour']], -1, (0, 255, 0), 2)
                    x, y = p.centroid

                    vd_um = p.vdiam_history[-1] * px_to_um
                    cv2.putText(output, f'ID:{p.id}',
                                (x-20, y-22), cv2.FONT_HERSHEY_SIMPLEX,
                                0.35, (255, 255, 0), 1)
                    cv2.putText(output, f'd={vd_um:.1f}\u00b5m',
                                (x-20, y-12), cv2.FONT_HERSHEY_SIMPLEX,
                                0.35, (0, 255, 255), 1)
                    cv2.putText(output, f'T={p.taylor_history[-1]:.3f}',
                                (x-20, y-2), cv2.FONT_HERSHEY_SIMPLEX,
                                0.35, (255, 128, 0), 1)
                    if p.peak_confirmed:
                        dD = p.taylor_derivative_history[-1]
                        label = (f'\u2605\u0394T={p.delta_taylor:.3f}'
                                 if p.delta_taylor is not None else '\u2605peaked')
                        cv2.putText(output, label,
                                    (x-20, y+8), cv2.FONT_HERSHEY_SIMPLEX,
                                    0.30, (180, 80, 255), 1)

                    if len(p.trajectory) > 1:
                        pts = np.array(p.trajectory, np.int32)
                        cv2.polylines(output, [pts], False,
                                      tuple(int(c*255) for c in p.color), 1)
                    cv2.circle(output, p.centroid, 3, (0, 255, 255), -1)
                    break

        return output, active


