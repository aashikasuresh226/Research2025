        self.log_box.pack(fill=tk.BOTH, expand=True, padx=8, pady=(0, 3))

    # ── param helpers ─────────────────────────────────────────────────────────
    def _parse_params(self):
        fps = float(self._fps_var.get())
        if fps <= 0: raise ValueError("Frame rate must be > 0")
        zoom = float(self._zoom_var.get())
        if zoom <= 0: raise ValueError("Zoom factor must be > 0")
        min_area = float(self._minarea_var.get())
        if min_area < 0: raise ValueError("Min area must be >= 0")
        um_per_px = float(self._umpx_var.get())
        if um_per_px <= 0: raise ValueError("Calibration (µm/px) must be > 0")
        return fps, zoom, min_area, um_per_px

    def _apply_params(self):
        try:
            fps, zoom, min_area, um_per_px = self._parse_params()
        except (ValueError, TypeError) as e:
            messagebox.showerror("Parameter error", str(e)); return
        self.fps, self._zoom_factor = fps, zoom
        self._min_area, self._um_per_px = min_area, um_per_px
        eff = um_per_px / zoom
        self._param_status.config(
            text=(f"✓ fps={fps}  zoom={zoom}×  min_area={min_area}px²  "
                  f"{um_per_px}µm/px@1×  → eff {eff:.4f}µm/px"), fg=ACCENT2)
        self._log(f"Params applied → fps={fps}  zoom={zoom}×  "
                  f"min_area={min_area}px²  eff={eff:.4f}µm/px")

    def _log(self, msg):
        self.log_box.configure(state=tk.NORMAL)
        self.log_box.insert(tk.END, f"[{time.strftime('%H:%M:%S')}]  {msg}\n")
        self.log_box.see(tk.END)
        self.log_box.configure(state=tk.DISABLED)

    def _browse(self):
        path = filedialog.askopenfilename(
            title="Select video file",
            filetypes=[("Video files", "*.avi *.mp4 *.mov *.mkv *.wmv"),
                       ("All files", "*.*")])
        if not path: return
        self.video_path = path
        self.output_dir = os.path.dirname(path)
        self._log(f"Loaded: {os.path.basename(path)}")
        self._btn["start"].config(state=tk.NORMAL)
        self.lbl_progress.config(text=os.path.basename(path))
        tmp = cv2.VideoCapture(path)
        self.total_frames = int(tmp.get(cv2.CAP_PROP_FRAME_COUNT))
        det_fps = tmp.get(cv2.CAP_PROP_FPS); tmp.release()
        if det_fps > 0:
            self.fps = det_fps
            self._fps_var.set(f"{det_fps:.2f}")
            self._log(f"  Auto-detected fps={det_fps:.2f}  |  {self.total_frames} frames")
        self.progress["maximum"] = max(self.total_frames, 1)
        self._param_status.config(text="")

    def _start(self):
        if self.running: return
        try:
            fps, zoom, min_area, um_per_px = self._parse_params()
        except (ValueError, TypeError) as e:
            messagebox.showerror("Parameter error", str(e)); return
        self.fps, self._zoom_factor = fps, zoom
        self._min_area, self._um_per_px = min_area, um_per_px
        self.engine.reset()
        self.frame_count = 0
        self.cap = cv2.VideoCapture(self.video_path)
        if not self.cap.isOpened():
            messagebox.showerror("Error", "Cannot open video file."); return
        self.running = True; self.paused = False
        self._stop_event.clear()
        self._btn["start"].config(state=tk.DISABLED)
        self._btn["pause"].config(state=tk.NORMAL)
        self._btn["stop"].config(state=tk.NORMAL)
        self._btn["export"].config(state=tk.DISABLED)
        eff = um_per_px / zoom
        self._log(f"Tracking started → fps={fps}  zoom={zoom}×  eff={eff:.4f}µm/px  "
                  f"peak_confirm={PEAK_CONFIRM_FRAMES}f  deriv_win={DERIV_WINDOW}f")
        self._thread = threading.Thread(target=self._run_loop, daemon=True)
        self._thread.start()

    def _pause(self):
        if not self.running: return
        self.paused = not self.paused
        self._btn["pause"].config(text="▶  Resume" if self.paused else "⏸  Pause")
        self._log("Paused." if self.paused else "Resumed.")

    def _stop(self):
        self._stop_event.set(); self.running = False; self.paused = False
        self._btn["pause"].config(text="⏸  Pause", state=tk.DISABLED)
        self._btn["stop"].config(state=tk.DISABLED)
        self._btn["start"].config(state=tk.NORMAL)
        self._btn["export"].config(state=tk.NORMAL)
        self._log("Stopped.")

    def _run_loop(self):
        plot_interval = 5
        while not self._stop_event.is_set():
            if self.paused: time.sleep(0.05); continue
            ret, frame = self.cap.read()
            if not ret: self.after(0, self._on_video_end); break
            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY) \
                   if len(frame.shape) == 3 else frame
            processed, active = self.engine.process_frame(
                gray, self.frame_count,
                zoom_factor=self._zoom_factor,
                min_area=self._min_area,
                um_per_px=self._um_per_px)
            snap = (processed.copy(), active,
                    self.frame_count, self.engine.total_unique_particles)
            self.after(0, self._update_gui, snap)
            if self.frame_count % plot_interval == 0:
                self.after(0, self._update_plots)
                self.after(0, self._update_table)
            self.frame_count += 1
        if self.cap: self.cap.release()

    def _on_video_end(self):
        self._log(f"Video complete — "
                  f"{self.engine.total_unique_particles} unique particles.")
        self._stop()
        self._update_plots()
        self._update_table()

    # ── GUI update ────────────────────────────────────────────────────────────
    def _update_gui(self, snapshot):
        processed, active, fc, unique = snapshot
        px_to_um = self._um_per_px / self._zoom_factor

        rgb   = cv2.cvtColor(processed, cv2.COLOR_BGR2RGB)
        cw    = self.canvas_video.winfo_width()  or 420
        ch    = self.canvas_video.winfo_height() or 480
        h, w  = rgb.shape[:2]
        scale = min(cw / w, ch / h)
        nw, nh = max(1, int(w*scale)), max(1, int(h*scale))
        rgb = cv2.resize(rgb, (nw, nh), interpolation=cv2.INTER_LINEAR)
        img = ImageTk.PhotoImage(Image.fromarray(rgb))
        self.canvas_video.configure(image=img); self.canvas_video.image = img

        # progress bar
        if self.total_frames > 0:
            self.progress["value"] = fc
            pct = fc / self.total_frames * 100
            self.lbl_progress.config(
                text=f"{fc}/{self.total_frames}  ({pct:.1f}%)")

        particles = self.engine.tracked_particles

        self._stat_vars["total_particles"].set(str(unique))
        self._stat_vars["active"].set(str(active))

        all_vd = [np.mean(p.vdiam_history) * px_to_um
                  for p in particles if p.vdiam_history]
        self._stat_vars["mean_vdiam"].set(
            f"{np.mean(all_vd):.2f}" if all_vd else "—")

        max_t = [p.max_taylor for p in particles]
        self._stat_vars["mean_taylor"].set(
            f"{np.mean(max_t):.4f}" if max_t else "—")

        peaked_count = sum(1 for p in particles if p.peak_confirmed)
        self._stat_vars["peaked"].set(str(peaked_count))

        dts = [abs(p.delta_taylor) for p in particles
               if p.delta_taylor is not None]
        self._stat_vars["mean_dT"].set(
            f"{np.mean(dts):.4f}" if dts else "—")

    # ── plots ─────────────────────────────────────────────────────────────────
    def _update_plots(self):
        particles = self.engine.tracked_particles
        px_to_um  = self._um_per_px / self._zoom_factor

        for ax in (self._ax_diam, self._ax_taylor):
            ax.clear()
            ax.set_facecolor(BG)
            ax.tick_params(colors=SUBTEXT, labelsize=7)
            for sp in ax.spines.values(): sp.set_edgecolor(BORDER)
            ax.grid(True, color=BORDER, linewidth=0.5)

        # Vertical diameter graph
        ax = self._ax_diam
        ax.set_title("Vertical (Y-axis) diameter per particle  (µm)",
                     color=TEXT, fontsize=8)
        ax.set_xlabel("Frame", color=SUBTEXT, fontsize=7)
        ax.set_ylabel("Y-diameter  (µm)", color=SUBTEXT, fontsize=7)
        for p in particles:
            if len(p.vdiam_history) > 1:
                vd_um = [v * px_to_um for v in p.vdiam_history]
                ax.plot(p.frame_history, vd_um,
                        color=p.color,
                        alpha=0.9 if p.alive else 0.35,
                        linewidth=1.2,
                        label=f'P{p.id}')
        hdl, lbl = ax.get_legend_handles_labels()
        if hdl:
            ax.legend(fontsize=5, loc='upper left',
                      facecolor=PANEL, labelcolor=TEXT, ncol=3)

        # Taylor graph
        ax = self._ax_taylor
        ax.set_title("Taylor parameter per particle", color=TEXT, fontsize=8)
        ax.set_xlabel("Frame", color=SUBTEXT, fontsize=7)
        ax.set_ylabel("D  (Taylor)", color=SUBTEXT, fontsize=7)
        ax.set_ylim(-0.05, 1.05)
        for p in particles:
            if len(p.taylor_history) > 1:
                ax.plot(p.frame_history, p.taylor_history,
                        color=p.color,
                        alpha=0.9 if p.alive else 0.35,
                        linewidth=1.2)
                ax.plot(p.max_taylor_frame, p.max_taylor,
                        '*', color=p.color, markersize=7,
                        label=f'P{p.id} peak={p.max_taylor:.3f}')
                if p.peak_confirmed:
                    ax.axvline(p.peak_confirmed_frame,
                               color=p.color, linestyle=':', alpha=0.35,
                               linewidth=0.8)
        hdl, lbl = ax.get_legend_handles_labels()
        if hdl:
            ax.legend(fontsize=5, loc='upper left',
                      facecolor=PANEL, labelcolor=TEXT, ncol=3)

        self.fig.tight_layout(pad=1.2)
        self.canvas_plot.draw_idle()

    # ── table update ──────────────────────────────────────────────────────────
    def _update_table(self):
        """Refresh the peak analysis table — only show particles that have
        passed through the peak-confirmation logic."""
        px_to_um  = self._um_per_px / self._zoom_factor
        fps       = self.fps
        particles = self.engine.tracked_particles

        # Clear existing rows
        for row in self._table.get_children():
            self._table.delete(row)

        for p in particles:
            # Show all particles; blanks where data not yet available
            tb = f"{p.taylor_before_peak:.4f}" \
                 if p.taylor_before_peak is not None else "—"
            tp = f"{p.max_taylor:.4f}"
            ta = f"{p.taylor_after_peak:.4f}" \
                 if p.taylor_after_peak is not None else "—"
            dt = f"{p.delta_taylor:+.4f}" \
                 if p.delta_taylor is not None else "—"

            vb = (f"{p.velocity_before_peak * fps * px_to_um:.2f}"
                  if p.velocity_before_peak is not None else "—")
            va = (f"{p.velocity_after_peak * fps * px_to_um:.2f}"
                  if p.velocity_after_peak is not None else "—")

            tag = "peaked" if p.peak_confirmed else "tracking"
            self._table.insert("", tk.END,
                               values=(p.id, tb, tp, ta, dt, vb, va),
                               tags=(tag,))

        # Colour peaked rows
        self._table.tag_configure("peaked",   foreground="#bc8cff")
        self._table.tag_configure("tracking", foreground=TEXT)

    # ── export ────────────────────────────────────────────────────────────────
    def _export(self):
        if not self.engine.tracked_particles:
            messagebox.showinfo("Export", "No tracking data to export.")
            return
        ts        = time.strftime('%Y%m%d_%H%M%S')
        fps       = self.fps
        zoom      = self._zoom_factor
        mina      = self._min_area
        um_per_px = self._um_per_px
        px_to_um  = um_per_px / zoom
        particles = self.engine.tracked_particles

        # ── 1. time-series CSV ────────────────────────────────────────────────
        ts_path = os.path.join(self.output_dir, f'particle_timeseries_{ts}.csv')
        with open(ts_path, 'w', newline='') as f:
            w = csv.writer(f)
            w.writerow(['# capture_fps', fps, 'zoom_factor', zoom,
                        'um_per_px_at_1x', um_per_px,
                        'effective_um_per_px', px_to_um,
                        'min_area_px2', mina,
                        'peak_confirm_frames', PEAK_CONFIRM_FRAMES,
                        'deriv_window_frames', DERIV_WINDOW])
            w.writerow([
                'particle_id', 'frame',
                'major_axis_px',   'major_axis_um',
                'minor_axis_px',   'minor_axis_um',
                'vdiam_px',        'vdiam_um',
                'taylor_parameter',
                'velocity_px_per_s', 'velocity_um_per_s',
                'frames_after_max_taylor',
                'dD_dt',
                'peak_confirmed',
            ])
            for p in particles:
                vel_px_s = [v * fps for v in p.velocity_history]
                vel_um_s = [v * fps * px_to_um for v in p.velocity_history]
                for i in range(len(p.frame_history)):
                    vel_px = f'{vel_px_s[i-1]:.4f}' \
                             if i > 0 and (i-1) < len(vel_px_s) else ''
                    vel_um = f'{vel_um_s[i-1]:.4f}' \
                             if i > 0 and (i-1) < len(vel_um_s) else ''
                    maj_px = p.major_history[i]
                    min_px = p.minor_history[i]
                    vd_px  = p.vdiam_history[i]
                    dD_val = p.taylor_derivative_history[i]
                    dD_str = f'{dD_val:.6f}' if not np.isnan(dD_val) else ''
                    w.writerow([
                        p.id, p.frame_history[i],
                        f'{maj_px:.4f}', f'{maj_px * px_to_um:.4f}',
                        f'{min_px:.4f}', f'{min_px * px_to_um:.4f}',
                        f'{vd_px:.4f}',  f'{vd_px  * px_to_um:.4f}',
                        f'{p.taylor_history[i]:.6f}',
                        vel_px, vel_um,
                        p.frame_history[i] - p.max_taylor_frame,
                        dD_str,
                        1 if p.peak_confirmed and
                             p.frame_history[i] >= (p.peak_confirmed_frame or 0)
                          else 0,
                    ])

        # ── 2. peak-analysis summary CSV ──────────────────────────────────────
        peak_path = os.path.join(self.output_dir,
                                 f'particle_peak_analysis_{ts}.csv')
        with open(peak_path, 'w', newline='') as f:
            w = csv.writer(f)
            w.writerow(['# capture_fps', fps, 'zoom_factor', zoom,
                        'um_per_px_at_1x', um_per_px,
                        'effective_um_per_px', px_to_um,
                        'min_area_px2', mina,
                        'peak_confirm_frames', PEAK_CONFIRM_FRAMES,
                        'deriv_window_frames', DERIV_WINDOW])
            w.writerow([
                'particle_id',
                'total_frames_tracked',
                'max_taylor_parameter',
                'frame_of_max_taylor',
                'taylor_before_peak',
                'taylor_at_peak',
                'taylor_after_peak',
                'delta_taylor_after_minus_before',   # signed: after − before
                'abs_delta_taylor',
                'peak_confirmed',
                'peak_confirmed_frame',
                'velocity_before_peak_um_per_s',
                'velocity_after_peak_um_per_s',
                'velocity_delta_um_per_s',           # after − before
                'mean_vdiam_um',
                'std_vdiam_um',
                'min_vdiam_um',
                'max_vdiam_um',
                'mean_major_um',
                'mean_minor_um',
                'initial_dD_dt_post_peak',
                'mean_dD_dt_post_peak',
                'viscoelastic_tau_frames',
                'viscoelastic_tau_seconds',
            ])
            for p in particles:
                vd_arr = np.array(p.vdiam_history) * px_to_um
                maj_arr = np.array(p.major_history) * px_to_um
                min_arr = np.array(p.minor_history) * px_to_um

                vb = (p.velocity_before_peak * fps * px_to_um
                      if p.velocity_before_peak is not None else None)
                va = (p.velocity_after_peak  * fps * px_to_um
                      if p.velocity_after_peak  is not None else None)
                vd_vel = ((va - vb) if (vb is not None and va is not None)
                          else None)

                tau_fr = p.compute_viscoelastic_tau()
                tau_s  = tau_fr / fps if tau_fr else None

                init_dD = p.initial_post_peak_dD_dt()
                mean_dD = p.mean_post_peak_dD_dt()

                def fmt(v, d=6): return f'{v:.{d}f}' if v is not None else ''

                w.writerow([
                    p.id,
                    len(p.frame_history),
                    fmt(p.max_taylor),
                    p.max_taylor_frame,
                    fmt(p.taylor_before_peak),
                    fmt(p.max_taylor),
                    fmt(p.taylor_after_peak),
                    fmt(p.delta_taylor),
                    fmt(abs(p.delta_taylor) if p.delta_taylor is not None else None),
                    1 if p.peak_confirmed else 0,
                    p.peak_confirmed_frame if p.peak_confirmed else '',
                    fmt(vb, 4),
                    fmt(va, 4),
                    fmt(vd_vel, 4),
                    fmt(float(np.mean(vd_arr)), 4),
                    fmt(float(np.std(vd_arr)),  4),
                    fmt(float(np.min(vd_arr)),  4),
                    fmt(float(np.max(vd_arr)),  4),
                    fmt(float(np.mean(maj_arr)), 4),
                    fmt(float(np.mean(min_arr)), 4),
                    fmt(init_dD),
                    fmt(mean_dD),
                    fmt(tau_fr, 4)  if tau_fr  else '',
                    fmt(tau_s,  6)  if tau_s   else '',
                ])

        # ── 3. size distribution CSV ──────────────────────────────────────────
        dist_path = os.path.join(self.output_dir,
                                 f'particle_size_distribution_{ts}.csv')
        with open(dist_path, 'w', newline='') as f:
            w = csv.writer(f)
            w.writerow(['# capture_fps', fps, 'zoom_factor', zoom,
                        'um_per_px_at_1x', um_per_px,
                        'effective_um_per_px', px_to_um])
            w.writerow([
                'particle_id',
                'mean_vdiam_um', 'std_vdiam_um',
                'mean_major_um', 'mean_minor_um',
                'mean_taylor_parameter',
            ])
            for p in particles:
                vd_arr  = np.array(p.vdiam_history) * px_to_um
                maj_arr = np.array(p.major_history)  * px_to_um
                min_arr = np.array(p.minor_history)  * px_to_um
                w.writerow([
                    p.id,
                    f'{np.mean(vd_arr):.4f}', f'{np.std(vd_arr):.4f}',
                    f'{np.mean(maj_arr):.4f}', f'{np.mean(min_arr):.4f}',
                    f'{np.mean(p.taylor_history):.6f}',
                ])

        self._log(f"Exported → {os.path.basename(ts_path)}")
        self._log(f"Exported → {os.path.basename(peak_path)}")
        self._log(f"Exported → {os.path.basename(dist_path)}")
        messagebox.showinfo(
            "Export complete",
            f"Saved 3 files:\n\n"
            f"1. {ts_path}\n\n"
            f"2. {peak_path}\n\n"
            f"3. {dist_path}")

    def _on_close(self):
        self._stop_event.set(); self.running = False
        if self.cap: self.cap.release()
        self.destroy()


