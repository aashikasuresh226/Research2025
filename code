    # ── parameter helpers ─────────────────────────────────────────────────────
    def _parse_params(self):
        fps = float(self._fps_var.get())
        if fps <= 0: raise ValueError("Frame rate must be > 0")
        zoom = float(self._zoom_var.get())
        if zoom <= 0: raise ValueError("Zoom factor must be > 0")
        min_area = float(self._minarea_var.get())
        if min_area < 0: raise ValueError("Min area must be >= 0")
        return fps, zoom, min_area

    def _apply_params(self):
        try:
            fps, zoom, min_area = self._parse_params()
        except (ValueError, TypeError) as e:
            messagebox.showerror("Parameter error", str(e))
            return
        self.fps             = fps
        self._zoom_factor    = zoom
        self._min_area       = min_area
        self.engine.MIN_AREA = min_area
        self._param_status.config(
            text=f"✓  fps={fps}  |  zoom={zoom}×  |  min area={min_area} px²",
            fg=ACCENT2)
        self._log(f"Params applied → fps={fps}  zoom={zoom}×  min_area={min_area}px²")

    # ── logging ───────────────────────────────────────────────────────────────
    def _log(self, msg):
        self.log_box.configure(state=tk.NORMAL)
        self.log_box.insert(tk.END, f"[{time.strftime('%H:%M:%S')}]  {msg}\n")
        self.log_box.see(tk.END)
        self.log_box.configure(state=tk.DISABLED)

    # ── file browse ───────────────────────────────────────────────────────────
    def _browse(self):
        path = filedialog.askopenfilename(
            title="Select video file",
            filetypes=[("Video files", "*.avi *.mp4 *.mov *.mkv *.wmv"),
                       ("All files", "*.*")]
        )
        if not path:
            return
        self.video_path = path
        self.output_dir = os.path.dirname(path)
        self._log(f"Loaded: {os.path.basename(path)}")
        self._btn["start"].config(state=tk.NORMAL)
        self.lbl_progress.config(text=os.path.basename(path))
        tmp = cv2.VideoCapture(path)
        self.total_frames = int(tmp.get(cv2.CAP_PROP_FRAME_COUNT))
        detected_fps = tmp.get(cv2.CAP_PROP_FPS)
        tmp.release()
        if detected_fps > 0:
            self.fps = detected_fps
            self._fps_var.set(f"{detected_fps:.2f}")
            self._log(f"  Auto-detected fps={detected_fps:.2f}  |  {self.total_frames} frames")
        else:
            self._log(f"  fps not detected – using {self.fps:.1f}")
        self.progress["maximum"] = max(self.total_frames, 1)
        self._param_status.config(text="")

    # ── start / pause / stop ──────────────────────────────────────────────────
    def _start(self):
        if self.running:
            return
        try:
            fps, zoom, min_area = self._parse_params()
        except (ValueError, TypeError) as e:
            messagebox.showerror("Parameter error", str(e))
            return
        self.fps          = fps
        self._zoom_factor = zoom
        self._min_area    = min_area

        self.engine.reset()
        self.frame_count = 0
        self.cap = cv2.VideoCapture(self.video_path)
        if not self.cap.isOpened():
            messagebox.showerror("Error", "Cannot open video file.")
            return
        self.running = True
        self.paused  = False
        self._stop_event.clear()
        self._btn["start"].config(state=tk.DISABLED)
        self._btn["pause"].config(state=tk.NORMAL)
        self._btn["stop"].config(state=tk.NORMAL)
        self._btn["export"].config(state=tk.DISABLED)
        self._log(f"Tracking started → fps={fps}  zoom={zoom}×  min_area={min_area}px²")
        self._thread = threading.Thread(target=self._run_loop, daemon=True)
        self._thread.start()

    def _pause(self):
        if not self.running:
            return
        self.paused = not self.paused
        self._btn["pause"].config(text="▶  Resume" if self.paused else "⏸  Pause")
        self._log("Paused." if self.paused else "Resumed.")

    def _stop(self):
        self._stop_event.set()
        self.running = False
        self.paused  = False
        self._btn["pause"].config(text="⏸  Pause", state=tk.DISABLED)
        self._btn["stop"].config(state=tk.DISABLED)
        self._btn["start"].config(state=tk.NORMAL)
        self._btn["export"].config(state=tk.NORMAL)
        self._log("Stopped.")

    # ── tracking loop ─────────────────────────────────────────────────────────
    def _run_loop(self):
        plot_interval = 5
        while not self._stop_event.is_set():
            if self.paused:
                time.sleep(0.05)
                continue
            ret, frame = self.cap.read()
            if not ret:
                self.after(0, self._on_video_end)
                break
            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY) if len(frame.shape)==3 else frame
            processed, active, f_diams, f_taylors = self.engine.process_frame(
                gray, self.frame_count,
                zoom_factor=self._zoom_factor,
                min_area=self._min_area
            )
            snapshot = (processed.copy(), active, f_diams[:], f_taylors[:],
                        self.frame_count, self.engine.total_unique_particles)
            self.after(0, self._update_gui, snapshot)
            if self.frame_count % plot_interval == 0:
                self.after(0, self._update_plots)
            self.frame_count += 1
        if self.cap:
            self.cap.release()

    def _on_video_end(self):
        self._log(f"Video complete. {self.engine.total_unique_particles} unique particles.")
        self._stop()
        self._update_plots()

    def _update_gui(self, snapshot):
        processed, active, f_diams, f_taylors, fc, unique = snapshot
        rgb = cv2.cvtColor(processed, cv2.COLOR_BGR2RGB)
        cw = self.canvas_video.winfo_width()  or 500
        ch = self.canvas_video.winfo_height() or 380
        h, w = rgb.shape[:2]
        scale = min(cw/w, ch/h)
        nw, nh = max(1, int(w*scale)), max(1, int(h*scale))
        rgb = cv2.resize(rgb, (nw, nh), interpolation=cv2.INTER_LINEAR)
        img = ImageTk.PhotoImage(Image.fromarray(rgb))
        self.canvas_video.configure(image=img)
        self.canvas_video.image = img
        md = f"{np.mean(f_diams):.1f} px" if f_diams else "—"
        mt = f"{np.mean(f_taylors):.4f}"  if f_taylors else "—"
        self._stat_vars["sample_n"].set(str(unique))
        self._stat_vars["active"].set(str(active))
        self._stat_vars["mean_diam"].set(md)
        self._stat_vars["mean_taylor"].set(mt)
        self._stat_vars["frame"].set(str(fc))
        self.progress["value"] = fc

    def _update_plots(self):
        particles = self.engine.tracked_particles
        fps       = self.fps
        axes      = self._axes
        for ax in axes.flat:
            ax.clear()
            ax.set_facecolor(BG)
            ax.tick_params(colors=SUBTEXT, labelsize=7)
            for sp in ax.spines.values():
                sp.set_edgecolor(BORDER)
            ax.grid(True, color=BORDER, linewidth=0.5)

        axes[0,0].set_title("Diameter / particle (px)", color=TEXT, fontsize=8)
        axes[0,0].set_xlabel("Frame", color=SUBTEXT, fontsize=7)
        axes[0,0].set_ylabel("px", color=SUBTEXT, fontsize=7)
        for p in particles:
            if len(p.diameter_history) > 1:
                axes[0,0].plot(p.frame_history, p.diameter_history,
                               color=p.color, alpha=0.9 if p.alive else 0.3, linewidth=1.2)

        axes[0,1].set_title("Taylor parameter / particle", color=TEXT, fontsize=8)
        axes[0,1].set_xlabel("Frame", color=SUBTEXT, fontsize=7)
        axes[0,1].set_ylabel("D", color=SUBTEXT, fontsize=7)
        axes[0,1].set_ylim(-0.05, 1.05)
        for p in particles:
            if len(p.taylor_history) > 1:
                a = 0.9 if p.alive else 0.3
                axes[0,1].plot(p.frame_history, p.taylor_history,
                               color=p.color, alpha=a, linewidth=1.2)
                axes[0,1].plot(p.max_taylor_frame, p.max_taylor,
                               '*', color=p.color, markersize=7)

        axes[1,0].set_title("Velocity before max Taylor (px/s)", color=TEXT, fontsize=8)
        axes[1,0].set_xlabel("Particle ID", color=SUBTEXT, fontsize=7)
        axes[1,0].set_ylabel("px/s", color=SUBTEXT, fontsize=7)
        ids, vels, cols = [], [], []
        for p in particles:
            try:
                peak_idx = p.taylor_history.index(p.max_taylor)
            except ValueError:
                continue
            if peak_idx > 0 and (peak_idx-1) < len(p.velocity_history):
                ids.append(p.id)
                vels.append(p.velocity_history[peak_idx-1] * fps)
                cols.append(p.color)
        if ids:
            axes[1,0].bar(ids, vels, color=cols, alpha=0.85)

        axes[1,1].set_title("Taylor relaxation  τ", color=TEXT, fontsize=8)
        axes[1,1].set_xlabel("Frames after peak", color=SUBTEXT, fontsize=7)
        axes[1,1].set_ylabel("D (norm)", color=SUBTEXT, fontsize=7)
        axes[1,1].set_ylim(-0.05, 1.1)
        for p in particles:
            tau = p.compute_viscoelastic_tau()
            if tau is None: continue
            try:
                idx = p.taylor_history.index(p.max_taylor)
            except ValueError:
                continue
            relax = np.array(p.taylor_history[idx:])
            if len(relax) < 4 or relax[0] <= 0: continue
            norm = relax / relax[0]
            t_ax = np.arange(len(relax))
            axes[1,1].plot(t_ax, norm, color=p.color, alpha=0.85, linewidth=1.2,
                           label=f'P{p.id} τ={tau:.1f}f')
            t_fit = np.linspace(0, len(relax)-1, 80)
            axes[1,1].plot(t_fit, np.exp(-t_fit/tau), '--', color=p.color, alpha=0.4)
        hdl, lbl = axes[1,1].get_legend_handles_labels()
        if hdl:
            axes[1,1].legend(fontsize=6, loc='upper right',
                             facecolor=PANEL, labelcolor=TEXT)
        self.fig.tight_layout(pad=1.2)
        self.canvas_plot.draw_idle()

    def _export(self):
        if not self.engine.tracked_particles:
            messagebox.showinfo("Export", "No tracking data to export.")
            return
        ts   = time.strftime('%Y%m%d_%H%M%S')
        fps  = self.fps
        zoom = self._zoom_factor
        mina = self._min_area
        particles = self.engine.tracked_particles

        ts_path = os.path.join(self.output_dir, f'particle_timeseries_{ts}.csv')
        with open(ts_path, 'w', newline='') as f:
            w = csv.writer(f)
            w.writerow(['# capture_fps', fps, 'zoom_factor', zoom, 'min_area_px2', mina])
            w.writerow(['particle_id','frame','diameter_px','taylor_parameter',
                        'velocity_px_per_s','frames_after_max_taylor'])
            for p in particles:
                vel_s = [v*fps for v in p.velocity_history]
                for i in range(len(p.frame_history)):
                    vel = f'{vel_s[i-1]:.4f}' if i>0 and (i-1)<len(vel_s) else ''
                    w.writerow([p.id, p.frame_history[i],
                                f'{p.diameter_history[i]:.4f}',
                                f'{p.taylor_history[i]:.6f}',
                                vel,
                                p.frame_history[i]-p.max_taylor_frame])

        sum_path = os.path.join(self.output_dir, f'particle_summary_{ts}.csv')
        with open(sum_path, 'w', newline='') as f:
            w = csv.writer(f)
            w.writerow(['# capture_fps', fps, 'zoom_factor', zoom, 'min_area_px2', mina])
            w.writerow(['particle_id','total_frames_tracked',
                        'mean_diameter_px','std_diameter_px',
                        'min_diameter_px','max_diameter_px',
                        'max_taylor_parameter','frame_of_max_taylor',
                        'velocity_before_max_taylor_px_per_s',
                        'viscoelastic_tau_frames','viscoelastic_tau_seconds'])
            for p in particles:
                try:
                    peak_idx = p.taylor_history.index(p.max_taylor)
                except ValueError:
                    peak_idx = 0
                vel_b = ''
                if peak_idx > 0 and (peak_idx-1) < len(p.velocity_history):
                    vel_b = f'{p.velocity_history[peak_idx-1]*fps:.4f}'
                tau_fr = p.compute_viscoelastic_tau()
                tau_s  = (tau_fr/fps) if tau_fr else ''
                d = p.diameter_history
                w.writerow([p.id, len(p.frame_history),
                            f'{np.mean(d):.4f}', f'{np.std(d):.4f}',
                            f'{np.min(d):.4f}',  f'{np.max(d):.4f}',
                            f'{p.max_taylor:.6f}', p.max_taylor_frame,
                            vel_b,
                            f'{tau_fr:.4f}' if tau_fr else '',
                            f'{tau_s:.6f}'  if tau_s != '' else ''])

        self._log(f"Exported → {os.path.basename(ts_path)}")
        self._log(f"Exported → {os.path.basename(sum_path)}")
        messagebox.showinfo("Export complete",
                            f"Saved to:\n{ts_path}\n{sum_path}")

    def _on_close(self):
        self._stop_event.set()
        self.running = False
        if self.cap:
            self.cap.release()
        self.destroy()


