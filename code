class Particle:
    def __init__(self, id, centroid, area, bbox):
        self.id = id
        self.centroid = centroid
        self.area = area
        self.bbox = bbox
        self.last_seen = 0
        self.trajectory = [centroid]
        self.areas_history = [area]
        self.frame_history = [0] 
        self.alive = True
        self.color = self.generate_color()
    
    def generate_color(self):
        hue = (self.id * 137.5) % 360
        saturation = 0.7 + (self.id % 3) * 0.1 
        value = 0.8 + (self.id % 2) * 0.2
        rgb = hsv_to_rgb([hue/360, saturation, value])
        return rgb
    
    def update(self, centroid, area, bbox, frame_num):
        self.centroid = centroid
        self.area = area
        self.bbox = bbox
        self.last_seen = frame_num
        self.trajectory.append(centroid)
        self.areas_history.append(area)
        self.frame_history.append(frame_num)
        if len(self.trajectory) > 50:
            self.trajectory.pop(0)
            self.areas_history.pop(0)
            self.frame_history.pop(0)

tracked_particles = []
