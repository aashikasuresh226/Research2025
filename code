class Particle:
    def __init__(self, pid, centroid, area, bbox, taylor, frame_num):
        self.id        = pid
        self.centroid  = centroid
        self.area      = area
        self.bbox      = bbox
        self.last_seen = frame_num
        self.alive     = True
        self.color     = self._gen_color()
        self.trajectory       = [centroid]
        self.frame_history    = [frame_num]
        self.diameter_history = [self._diameter(area)]
        self.taylor_history   = [taylor]
        self.velocity_history = []
        self.max_taylor             = taylor
        self.max_taylor_frame       = frame_num
        self.velocity_at_max_taylor = None
        self.viscoelastic_tau       = None

    @staticmethod
    def _diameter(area):
        return 2.0 * np.sqrt(max(area, 0) / np.pi)

    def _gen_color(self):
        hue = (self.id * 137.5) % 360
        sat = 0.7 + (self.id % 3) * 0.1
        val = 0.8 + (self.id % 2) * 0.2
        return hsv_to_rgb([hue / 360, sat, val])

    def update(self, centroid, area, bbox, taylor, frame_num):
        if self.trajectory:
            dx = centroid[0] - self.trajectory[-1][0]
            dy = centroid[1] - self.trajectory[-1][1]
            self.velocity_history.append(np.sqrt(dx*dx + dy*dy))
        self.centroid  = centroid
        self.area      = area
        self.bbox      = bbox
        self.last_seen = frame_num
        self.trajectory.append(centroid)
        self.frame_history.append(frame_num)
        self.diameter_history.append(self._diameter(area))
        self.taylor_history.append(taylor)
        if taylor > self.max_taylor:
            self.max_taylor       = taylor
            self.max_taylor_frame = frame_num
        if len(self.trajectory) > 50:
            self.trajectory.pop(0)

    def compute_viscoelastic_tau(self):
        try:
            idx = self.taylor_history.index(self.max_taylor)
        except ValueError:
            return None
        relax = np.array(self.taylor_history[idx:])
        if len(relax) < 4 or relax[0] <= 0:
            return None
        t = np.arange(len(relax), dtype=float)
        log_r = np.log(np.clip(relax / relax[0], 1e-9, None))
        if np.all(log_r == 0):
            return None
        slope, _ = np.polyfit(t, log_r, 1)
        return (-1.0 / slope) if slope < 0 else None


class ParticleEngine:
    def __init__(self):
        self.reset()

    def reset(self):
        self.tracked_particles      = []
        self.next_particle_id       = 1
        self.total_unique_particles = 0
        self.max_distance_threshold = 50
        self.max_frames_disappeared = 10
        self.MIN_AREA               = 10

    @staticmethod
    def compute_taylor(contour):
        if len(contour) >= 5:
            try:
                (_, _), (ma, mi), _ = cv2.fitEllipse(contour)
                L, B = max(ma, mi) / 2.0, min(ma, mi) / 2.0
                d = L + B
                return float((L - B) / d) if d > 0 else 0.0
            except cv2.error:
                pass
        (_, _), (w, h), _ = cv2.minAreaRect(contour)
        L, B = max(w, h) / 2.0, min(w, h) / 2.0
        d = L + B
        return float((L - B) / d) if d > 0 else 0.0

    @staticmethod
    def centroid(contour):
        M = cv2.moments(contour)
        if M["m00"] != 0:
            return (int(M["m10"]/M["m00"]), int(M["m01"]/M["m00"]))
        x, y, w, h = cv2.boundingRect(contour)
        return (x + w//2, y + h//2)

    def _match(self, detections, frame_num):
        for p in self.tracked_particles:
            if p.alive and frame_num - p.last_seen > self.max_frames_disappeared:
                p.alive = False
        if not detections:
            return
        det_cents   = [d['centroid'] for d in detections]
        alive       = [p for p in self.tracked_particles if p.alive]
        alive_cents = [p.centroid for p in alive]
        used_p, used_d, matched = set(), set(), []
        if alive_cents:
            dm = cdist(alive_cents, det_cents)
            while True:
                tmp = dm.copy()
                for pi in used_p: tmp[pi,:] = np.inf
                for di in used_d: tmp[:,di] = np.inf
                pi, di = np.unravel_index(np.argmin(tmp), tmp.shape)
                if tmp[pi,di] >= self.max_distance_threshold:
                    break
                matched.append((pi,di)); used_p.add(pi); used_d.add(di)
        for pi, di in matched:
            d = detections[di]
            alive[pi].update(d['centroid'],d['area'],d['bbox'],d['taylor'],frame_num)
        for di, d in enumerate(detections):
            if di not in used_d:
                p = Particle(self.next_particle_id, d['centroid'], d['area'],
                             d['bbox'], d['taylor'], frame_num)
                self.tracked_particles.append(p)
                self.next_particle_id       += 1
                self.total_unique_particles += 1

    def process_frame(self, image, frame_num, zoom_factor=1.0, min_area=10):
        """
        zoom_factor : optical magnification (e.g. 2.0 = 2x zoom).
                      Area is divided by zoom² to keep measurements consistent.
        min_area    : minimum particle area in scaled px² to accept as a detection.
        """
        self.MIN_AREA = min_area

        x1, y1, x2, y2 = 262, 239, 370, 365
        og_h, og_w = image.shape
        scale_w = (x2 - x1) / og_w
        scale_h = (y2 - y1) / og_h
        area_scale = (scale_h * scale_w) / (zoom_factor ** 2)

        cropped = image[y1:y2, x1:x2]
        blurred = cv2.GaussianBlur(cropped, (7,7), 0)
        _, thresh = cv2.threshold(blurred, 0, 255, cv2.THRESH_BINARY+cv2.THRESH_OTSU)
        if np.sum(thresh==255) > np.sum(thresh==0):
            thresh = cv2.bitwise_not(thresh)
        kernel  = np.ones((2,2), np.uint8)
        opening = cv2.morphologyEx(thresh, cv2.MORPH_OPEN, kernel, iterations=1)
        sure_bg = cv2.dilate(opening, kernel, iterations=2)
        dt      = cv2.distanceTransform(opening, cv2.DIST_L2, 5)
        _, sure_fg = cv2.threshold(dt, 0.2*dt.max(), 255, 0)
        sure_fg = np.uint8(sure_fg)
        unknown = cv2.subtract(sure_bg, sure_fg)
        _, markers = cv2.connectedComponents(sure_fg)
        markers += 1; markers[unknown==255] = 0
        color_img = cv2.cvtColor(cropped, cv2.COLOR_GRAY2BGR)
        markers   = cv2.watershed(color_img, markers)
        output = color_img.copy()
        output[markers==-1] = [0,0,255]

        detections = []
        for mv in np.unique(markers):
            if mv <= 1: continue
            mask = np.uint8(markers==mv)
            cnts, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
            for cnt in cnts:
                area = cv2.contourArea(cnt) * area_scale
                if area < self.MIN_AREA or cv2.arcLength(cnt,True) <= 0:
                    continue
                detections.append({
                    'contour' : cnt,
                    'area'    : area,
                    'centroid': self.centroid(cnt),
                    'bbox'    : cv2.boundingRect(cnt),
                    'taylor'  : self.compute_taylor(cnt),
                })

        self._match(detections, frame_num)

        frame_diams, frame_taylors, active = [], [], 0
        for p in self.tracked_particles:
            if not p.alive or frame_num - p.last_seen > 1:
                continue
            active += 1
            frame_diams.append(p.diameter_history[-1])
            frame_taylors.append(p.taylor_history[-1])
            for det in detections:
                if det['centroid'] == p.centroid:
                    cv2.drawContours(output, [det['contour']], -1, (0,255,0), 2)
                    x, y = p.centroid
                    cv2.putText(output, f'ID:{p.id}',      (x-20,y-22), cv2.FONT_HERSHEY_SIMPLEX, 0.35, (255,255,0), 1)
                    cv2.putText(output, f'd={p.diameter_history[-1]:.1f}', (x-20,y-12), cv2.FONT_HERSHEY_SIMPLEX, 0.35, (0,255,255), 1)
                    cv2.putText(output, f'T={p.taylor_history[-1]:.3f}',   (x-20,y-2),  cv2.FONT_HERSHEY_SIMPLEX, 0.35, (255,128,0), 1)
                    if len(p.trajectory) > 1:
                        pts = np.array(p.trajectory, np.int32)
                        cv2.polylines(output, [pts], False, tuple(int(c*255) for c in p.color), 1)
                    cv2.circle(output, p.centroid, 3, (0,255,255), -1)
                    break

        return output, active, frame_diams, frame_taylors


